// -*- mode:c -*-

#include <bash/builtins.h>
#ifndef EXECUTION_FAILURE
#include <bash/shell.h>
#endif

// Create access to an otherwise unavailable functions
// in the Bash runtime environment:
extern int execute_command PARAMS((COMMAND *));

#include <stdio.h>
#include <stdarg.h>
#include <stdbool.h>

#include "utilities.c"

#include <argeater.h>

#define DEFAULT_VALUE_NAME "TEMPLATE_VALUE"
static const char *help_flag = NULL;
static const char *value_name = NULL;

AE_ITEM actions[] = {
   { &help_flag, "help", 'h', AET_FLAG_OPTION,
     "Show usage instructions." },

   { &value_name, "var", 'v', AET_VALUE_OPTION,
     "Change the result variable name from TEMPLATE_VALUE to VAR." }
};

static const char *error_name = "TEMPLATE_ERROR";

int printf_to_error_var(const char *format, ...)
{
   va_list list_args;
   va_start(list_args, format);

   int len = 0;

   SHELL_VAR *sv_error = NULL;
   if (get_or_make_shell_var(&sv_error, error_name))
      len = vprintf_to_shell_var(sv_error, format, list_args);
   else
      len = vdprintf(STDERR_FILENO, format, list_args);

   va_end(list_args);

   return len;
}

/**
 * @brief Call to clear TEMPLATE_ERROR if it's in use
 */
void drain_error_sink(void)
{
   SHELL_VAR *sv = find_variable(error_name);
   if (sv)
      sterilize_shell_var(error_name);
}

/**
 * @brief Clear TEMPLATE_VALUE before each call
 */
void clear_result_value(const char *value_name)
{
   SHELL_VAR *sv = find_variable(value_name);
   if (sv)
      sterilize_shell_var(value_name);
}

/*
 * Uncomment only one of the following for error reporting.
 * Use 'printf_to_shell_var' to put error message in a variable,
 * otherwise use 'printf' to immediately print error messages:
 *
 * On formatting error messages:
 *   - Don't include a trailing newline if you are using
 *     'printf_to_shell_var' because the script should decide
 *     how the error output will be formatted.
 */
int (*ERROR_SINK)(const char *format, ...) = printf_to_error_var;
// int (*ERROR_SINK)(const char *format, ...) = printf;

void show_usage(AE_MAP *map)
{
   argeater_show_usage(map,"TEMPLATE");
   argeater_show_options(map, 3);
   argeater_show_arguments(map, 3);
}

static int TEMPLATE_builtin(WORD_LIST *list)
{
   int  retval = EXECUTION_FAILURE;
   drain_error_sink();

   help_flag = NULL;
   value_name = DEFAULT_VALUE_NAME;
   clear_result_value(value_name);

   ACLONE *clones = CLONE_WORD_LIST(list);
   AE_MAP map = INIT_MAP(actions);

   argeater_set_error_sink(ERROR_SINK);

   if (argeater_process(clones, &map))
   {
      if (help_flag)
      {
         show_usage(&map);
         retval = EXECUTION_SUCCESS;
         goto early_exit;
      }

      // Template for returning a value:
      SHELL_VAR *rsv = NULL;
      if (get_or_make_shell_var(&rsv, value_name))
      {
         printf_to_shell_var(rsv, "Hello from Bash builtin TEMPLATE.");
         retval = EXECUTION_SUCCESS;
      }
      else
         (*ERROR_SINK)("failed to secure result shell variable %s", value_name);
   }

  early_exit:
   return retval;
}

static char *desc_TEMPLATE[] = {
   "TEMPLATE - My Bash builtin",
   "",
   "Use Bash builtin 'TEMPLATE' to do cool stuff.",
   (char *)NULL
};

struct builtin TEMPLATE_struct = {
   .name      = "TEMPLATE",
   .function  = TEMPLATE_builtin,
   .flags     = BUILTIN_ENABLED,
   .long_doc  = desc_TEMPLATE,
   .short_doc = "TEMPLATE [arguments]",
   .handle    = 0
};


